{
  "name": "confluence-rest-mcp",
  "version": "1.0.1",
  "type": "module",
  "description": "Confluence Server MCP for document search, structured reads, attachments, and controlled writes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x1nfinity/confluence-rest-mcp.git"
  },
  "homepage": "https://github.com/x1nfinity/confluence-rest-mcp#readme",
  "bugs": {
    "url": "https://github.com/x1nfinity/confluence-rest-mcp/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "bin": {
    "confluence-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/CONFIGURATION.md",
    "docs/COLLABORATION.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check:windows": "node scripts/windows-acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/keyring": "2.1.1",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "confluence",
    "confluence-server",
    "atlassian",
    "ai-tools"
  ]
}
